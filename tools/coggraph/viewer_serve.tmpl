#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""认知图查看器 · 本地服务（仅标准库）。用法：python serve.py [端口] [MDCG_ROOT]"""
import http.server
import io
import json
import os
import socketserver
import sys
import urllib.parse

ROOT = os.path.dirname(os.path.abspath(__file__))
MDCG = os.environ.get("MDCG_ROOT", "")
if len(sys.argv) > 2:
    MDCG = sys.argv[2]
if not MDCG:
    sibling = os.path.join(os.path.dirname(ROOT), "mdcg")
    if os.path.isdir(sibling):
        MDCG = sibling

with io.open(os.path.join(ROOT, "viewer_graph.json"), encoding="utf-8") as f:
    GRAPH = json.load(f)
BY_ID = {n["id"]: n for n in GRAPH["nodes"]}


def node_detail(nid):
    meta = BY_ID.get(nid)
    if meta is None:
        return {"id": nid, "error": "未知节点"}
    out = dict(meta)
    out.pop("x", None)
    out.pop("y", None)
    out["content"] = "(未配置 MDCG_ROOT，无法读取正文)"
    p = meta.get("path", "")
    if MDCG and p:
        fp = os.path.join(MDCG, p.replace("/", os.sep))
        if os.path.isfile(fp):
            # utf-8-sig 剥 BOM：BOM 会让 startswith("---") 判否，front matter 被整段当正文展示（issue #412 同族）。
            with io.open(fp, encoding="utf-8-sig", errors="replace") as f:
                raw = f.read()
            if raw.startswith("---"):
                end = raw.find("\n---", 3)
                body = raw[end + 4:] if end > 0 else raw
            else:
                body = raw
            out["content"] = body[:8000]
    return out


class H(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *a, **k):
        super().__init__(*a, directory=ROOT, **k)

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        if u.path == "/api/node":
            q = urllib.parse.parse_qs(u.query)
            nid = (q.get("id") or [""])[0]
            body = json.dumps(node_detail(nid), ensure_ascii=False).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        return super().do_GET()

    def log_message(self, *a):
        pass


class S(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


if __name__ == "__main__":
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8788
    print("灵枢认知图查看器: http://127.0.0.1:%d  (MDCG_ROOT=%s)" % (port, MDCG or "(未配置)"))
    with S(("127.0.0.1", port), H) as httpd:
        httpd.serve_forever()
